{
  "opencollection": "1.0.0",
  "info": {
    "name": "elastic.io Platform REST Agents Logs API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Logs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Elastic.io List execution logs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.elastic.io/v2/logs",
            "params": [
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "Number of items per page"
              },
              {
                "name": "page[number]",
                "value": "",
                "type": "query",
                "description": "Page number to retrieve"
              },
              {
                "name": "filter[workspace_id]",
                "value": "",
                "type": "query",
                "description": "Filter by workspace ID"
              },
              {
                "name": "filter[flow_id]",
                "value": "",
                "type": "query",
                "description": "Filter by flow ID"
              },
              {
                "name": "filter[from]",
                "value": "",
                "type": "query",
                "description": "Filter logs from this timestamp"
              },
              {
                "name": "filter[to]",
                "value": "",
                "type": "query",
                "description": "Filter logs to this timestamp"
              }
            ]
          },
          "docs": "Retrieve execution logs for flows."
        }
      ]
    }
  ],
  "bundled": true
}