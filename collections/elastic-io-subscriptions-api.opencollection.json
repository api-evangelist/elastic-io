          "info": {
            "name": "Elastic.io List subscriptions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.elastic.io/v2/subscriptions",
            "params": [
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "Number of items per page"
              },
              {
                "name": "page[number]",
                "value": "",
                "type": "query",
                "description": "Page number to retrieve"
              },
              {
                "name": "filter[workspace_id]",
                "value": "",
                "type": "query",
                "description": "Filter by workspace ID"
              }
            ]
          },
          "docs": "Retrieve a list of topic subscriptions."
        },
        {
          "info": {
            "name": "Elastic.io Create a subscription",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.elastic.io/v2/subscriptions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new topic subscription."
        },
        {
          "info": {
            "name": "Elastic.io Get a subscription",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.elastic.io/v2/subscriptions/:subscription_id",
            "params": [
              {
                "name": "subscription_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve details of a specific subscription."
        },
        {
          "info": {
            "name": "Elastic.io Delete a subscription",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.elastic.io/v2/subscriptions/:subscription_id",
            "params": [
              {
                "name": "subscription_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a topic subscription."
        }
      ]
    }
  ],
  "bundled": true
