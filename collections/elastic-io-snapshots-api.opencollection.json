{
  "opencollection": "1.0.0",
  "info": {
    "name": "elastic.io Platform REST Agents Snapshots API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Snapshots",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Elastic.io List snapshots",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.elastic.io/v2/snapshots",
            "params": [
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "Number of items per page"
              },
              {
                "name": "page[number]",
                "value": "",
                "type": "query",
                "description": "Page number to retrieve"
              },
              {
                "name": "filter[flow_id]",
                "value": "",
                "type": "query",
                "description": "Filter by flow ID"
              }
            ]
          },
          "docs": "Retrieve a list of flow step snapshots."
        }
      ]
    }
  ],
  "bundled": true
}